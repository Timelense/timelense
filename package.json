{
  "name": "timelense",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run android --workspace=mobile",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "test": "npm run test --workspace=backend",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend",
    "release": "npm run release --workspace=mobile",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=backend"
  },
  "overrides": {
    "react": "19.2.3"
  }
}